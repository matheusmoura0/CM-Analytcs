<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">💰 Monetization Dashboard</h1>
    <p class="mt-1 text-gray-600">Análise de receitas e performance publicitária</p>
  </div>

  <!-- Revenue Metrics -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-lg shadow-lg p-6 text-white">
      <p class="text-sm font-medium opacity-90">Receita Total (Mês)</p>
      <p class="text-3xl font-bold mt-2"><%= format_currency(@revenue_by_section.sum { |s| s[:revenue] }) %></p>
    </div>

    <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg shadow-lg p-6 text-white">
      <p class="text-sm font-medium opacity-90">RPM Médio</p>
      <p class="text-3xl font-bold mt-2"><%= number_to_currency(@avg_rpm, unit: '€', precision: 2) %></p>
    </div>

    <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg shadow-lg p-6 text-white">
      <p class="text-sm font-medium opacity-90">CPM Médio</p>
      <p class="text-3xl font-bold mt-2"><%= number_to_currency(@avg_cpm, unit: '€', precision: 2) %></p>
    </div>

    <div class="bg-gradient-to-br from-orange-500 to-orange-600 rounded-lg shadow-lg p-6 text-white">
      <p class="text-sm font-medium opacity-90">Artigos Monetizados</p>
      <p class="text-3xl font-bold mt-2"><%= format_number(AdMetric.for_date_range(Date.today.beginning_of_month, Date.today).distinct.count(:article_id)) %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
    <!-- Revenue by Section -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">📂 Receita por Secção</h2>
      <%= pie_chart @revenue_by_section.map { |s| [s[:section], s[:revenue]] }.to_h, library: { options: { plugins: { legend: { position: 'bottom' } } } } %>
      
      <div class="mt-4 space-y-2">
        <% @revenue_by_section.sort_by { |s| -s[:revenue] }.first(5).each do |section| %>
          <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
            <span class="text-sm font-medium text-gray-700"><%= section[:section] %></span>
            <span class="font-bold text-emerald-600"><%= format_currency(section[:revenue]) %></span>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Revenue by Author -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">✍️ Receita por Autor</h2>
      <div class="space-y-3">
        <% @revenue_by_author.sort_by { |a| -a[:revenue] }.first(10).each do |author| %>
          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
            <div class="flex-1">
              <p class="font-medium text-gray-900"><%= author[:author] %></p>
            </div>
            <div class="text-right">
              <span class="text-xl font-bold text-emerald-600"><%= format_currency(author[:revenue]) %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Top Revenue Articles -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">💎 Top Artigos por Receita</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Artigo</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Receita</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">RPM</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">CPM</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @top_revenue_articles.each do |article| %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-medium text-gray-900"><%= article[:title] %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm font-bold text-emerald-600"><%= format_currency(article[:revenue]) %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= number_to_currency(article[:rpm], unit: '€', precision: 2) %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                <%= number_to_currency(article[:cpm], unit: '€', precision: 2) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
