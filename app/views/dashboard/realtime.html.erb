<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900 flex items-center">
      <span class="relative flex h-3 w-3 mr-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
      </span>
      Real-time Dashboard
    </h1>
    <p class="mt-1 text-gray-600">Métricas em tempo real - atualizadas automaticamente</p>
  </div>

  <!-- Real-time Stats -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
    <div class="bg-gradient-to-br from-red-500 to-red-600 rounded-lg shadow-lg p-6 text-white">
      <p class="text-sm font-medium opacity-90">Utilizadores Ativos</p>
      <p class="text-3xl font-bold mt-2" id="active-users"><%= @active_users %></p>
      <p class="text-xs mt-2 opacity-75">últimos 5 minutos</p>
    </div>

    <div class="bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg shadow-lg p-6 text-white">
      <p class="text-sm font-medium opacity-90">Page Views (1h)</p>
      <p class="text-3xl font-bold mt-2" id="pageviews-hour"><%= format_number(AnalyticsEvent.where('created_at > ?', 1.hour.ago).count) %></p>
      <p class="text-xs mt-2 opacity-75">última hora</p>
    </div>

    <div class="bg-gradient-to-br from-green-500 to-green-600 rounded-lg shadow-lg p-6 text-white">
      <p class="text-sm font-medium opacity-90">Discover Clicks</p>
      <p class="text-3xl font-bold mt-2"><%= format_number(DiscoverMetric.for_date(Date.today).sum(:clicks)) %></p>
      <p class="text-xs mt-2 opacity-75">hoje</p>
    </div>

    <div class="bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg shadow-lg p-6 text-white">
      <p class="text-sm font-medium opacity-90">Homepage CTR</p>
      <% total_pv = AnalyticsEvent.page_views.by_date(Date.today).count %>
      <% total_hc = @homepage_clicks.values.sum %>
      <p class="text-3xl font-bold mt-2"><%= total_pv > 0 ? format_percent(total_hc.to_f / total_pv * 100) : '0.0%' %></p>
      <p class="text-xs mt-2 opacity-75">hoje</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Trending Articles -->
    <div class="lg:col-span-2 bg-white rounded-lg shadow p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-gray-900">🔥 Artigos em Destaque</h2>
        <span class="text-sm text-gray-500">última hora</span>
      </div>
      <div class="space-y-3" id="trending-articles">
        <% @trending_articles.each do |(id, title), count| %>
          <div class="flex items-center justify-between p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition">
            <div class="flex-1">
              <p class="font-medium text-gray-900"><%= title %></p>
              <p class="text-sm text-gray-500">Article ID: <%= id %></p>
            </div>
            <div class="text-right">
              <span class="text-2xl font-bold text-red-600"><%= format_number(count) %></span>
              <p class="text-xs text-gray-500">views</p>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Traffic Sources -->
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">📊 Fontes de Tráfego</h2>
      <%= pie_chart @traffic_sources, library: { options: { plugins: { legend: { position: 'bottom' } } } } %>
      
      <div class="mt-6 space-y-2">
        <% @traffic_sources.sort_by { |k, v| -v }.first(5).each do |source, count| %>
          <div class="flex items-center justify-between">
            <span class="text-sm text-gray-600"><%= source %></span>
            <span class="font-medium text-gray-900"><%= format_number(count) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Live Activity Feed -->
  <div class="mt-6 bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">⚡ Atividade Recente</h2>
    <div class="space-y-2 max-h-96 overflow-y-auto" id="live-feed">
      <% AnalyticsEvent.where('created_at > ?', 5.minutes.ago).order(created_at: :desc).limit(20).each do |event| %>
        <div class="flex items-center text-sm py-2 border-b border-gray-100 last:border-0">
          <span class="text-gray-400 w-24"><%= event.created_at.strftime('%H:%M:%S') %></span>
          <span class="px-2 py-1 bg-<%= event.traffic_medium == 'search' ? 'blue' : event.traffic_medium == 'social' ? 'pink' : 'gray' %>-100 text-<%= event.traffic_medium == 'search' ? 'blue' : event.traffic_medium == 'social' ? 'pink' : 'gray' %>-800 rounded text-xs mr-3">
            <%= event.traffic_medium %>
          </span>
          <span class="flex-1 text-gray-700"><%= event.title %></span>
          <span class="text-gray-500"><%= event.device_type %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  // Auto-refresh every 30 seconds
  setTimeout(function() {
    location.reload();
  }, 30000);
</script>
