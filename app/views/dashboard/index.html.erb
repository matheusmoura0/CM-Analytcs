<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">CM Analytics Dashboard</h1>
    <p class="mt-2 text-gray-600">Bem-vindo à plataforma de analytics editorial do Correio da Manhã</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-1">
          <p class="text-sm font-medium text-gray-500">Page Views Hoje</p>
          <p class="text-2xl font-bold text-gray-900"><%= format_number(AnalyticsEvent.page_views.by_date(Date.today).count) %></p>
        </div>
        <div class="ml-4">
          <svg class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-1">
          <p class="text-sm font-medium text-gray-500">Artigos Únicos</p>
          <p class="text-2xl font-bold text-gray-900"><%= format_number(AnalyticsEvent.page_views.by_date(Date.today).distinct.count(:article_id)) %></p>
        </div>
        <div class="ml-4">
          <svg class="h-8 w-8 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-1">
          <p class="text-sm font-medium text-gray-500">Sessões Ativas</p>
          <p class="text-2xl font-bold text-gray-900"><%= format_number(AnalyticsEvent.where('created_at > ?', 5.minutes.ago).group(:session_id).count.keys.length) %></p>
        </div>
        <div class="ml-4">
          <svg class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <div class="flex items-center">
        <div class="flex-1">
          <p class="text-sm font-medium text-gray-500">Tempo Médio</p>
          <p class="text-2xl font-bold text-gray-900"><%= AnalyticsEvent.where.not(time_on_page: nil).where('created_at > ?', 24.hours.ago).average(:time_on_page).to_i %>s</p>
        </div>
        <div class="ml-4">
          <svg class="h-8 w-8 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Tráfego por Fonte</h2>
      <% sources = AnalyticsEvent.page_views.by_date(Date.today).traffic_sources %>
      <%= pie_chart sources, library: { options: { plugins: { legend: { position: 'bottom' } } } } %>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Top 5 Artigos Hoje</h2>
      <% top_articles = AnalyticsEvent.page_views.by_date(Date.today).group(:article_id, :title).count.sort_by { |k, v| -v }.first(5) %>
      <div class="space-y-3">
        <% top_articles.each do |(id, title), count| %>
          <div class="flex items-center justify-between p-3 bg-gray-50 rounded">
            <div class="flex-1">
              <p class="font-medium text-gray-900"><%= title %></p>
              <p class="text-sm text-gray-500">ID: <%= id %></p>
            </div>
            <span class="text-lg font-bold text-red-600"><%= format_number(count) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
