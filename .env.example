# Database Configuration
DATABASE_URL=postgresql://cm_analytics:password@localhost:5432/cm_analytics_development

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Rails Configuration
RAILS_ENV=development
SECRET_KEY_BASE=generate_with_bin_rails_secret
RAILS_LOG_LEVEL=info

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Analytics Configuration
CM_ANALYTICS_SITE_ID=your-site-id
CM_ANALYTICS_DEBUG=false

# External Integrations
GOOGLE_SEARCH_CONSOLE_API_KEY=
GOOGLE_AD_MANAGER_API_KEY=

# Session Configuration
RAILS_MAX_THREADS=5
